rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // Eigenes Profil (Name + welche gemeinsame Liste)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Verbindungs-Codes: nur nachschlagen, wenn man den Code kennt
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn();
    }

    // Gemeinsame Liste – nur für die zwei Mitglieder
    match /households/{hid} {
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        // Beitreten mit Code: sich selbst hinzufügen, maximal 2 Personen
        (resource.data.members.size() < 2 &&
         request.resource.data.members == resource.data.members.concat([request.auth.uid]) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names']))
      );

      match /{document=**} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
